{
  "schema": "workspace-recover/archive-profile/v3",
  "kind": "exec",
  "format": "tar.gz",
  "requires": {
    "executables": [
      "tar"
    ]
  },
  "bootstrap": [],
  "pack": {
    "argv": [
      "tar",
      "--format=pax",
      "--hard-dereference",
      "--null",
      "--verbatim-files-from",
      "--no-recursion",
      "-C",
      "${sourceRoot}",
      "-czf",
      "${archivePath}",
      "-T",
      "${selectionNul}"
    ],
    "timeoutMs": 900000
  },
  "unpack": {
    "argv": [
      "tar",
      "-xzf",
      "${archivePath}",
      "--no-same-owner",
      "--same-permissions",
      "--delay-directory-restore",
      "-C",
      "${targetRoot}"
    ],
    "timeoutMs": 900000
  }
}
