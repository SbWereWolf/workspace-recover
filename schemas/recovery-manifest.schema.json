{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-recover/recovery-manifest/v3",
  "type": "object",
  "required": [
    "schema",
    "backupSessionId",
    "transport",
    "restore"
  ],
  "properties": {
    "schema": {
      "const": "workspace-recover/recovery-manifest/v3"
    },
    "backupSessionId": {
      "type": "string"
    },
    "transport": {
      "$ref": "transport-manifest.schema.json"
    },
    "restore": {
      "type": "object",
      "properties": {
        "workflow": {
          "$ref": "workflow.schema.json"
        },
        "target": {
          "type": "object"
        }
      }
    },
    "requires": {
      "$ref": "requirements.schema.json"
    },
    "selection": {
      "type": "object",
      "required": [
        "bytes",
        "sha256",
        "remote"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "remote": {
          "type": "object",
          "required": [
            "id"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
