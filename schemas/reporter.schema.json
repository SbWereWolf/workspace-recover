{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-recover/reporter/v3",
  "type": "object",
  "properties": {
    "profile": {
      "enum": [
        "command-output",
        "json",
        "json-lines",
        "junit",
        "tap",
        "artifact-list",
        "custom-command"
      ]
    },
    "source": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1
    }
  }
}
