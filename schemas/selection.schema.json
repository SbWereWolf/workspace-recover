{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-recover/selection/v3",
  "type": "object",
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "workspace-recover/selection/v3"
    },
    "patterns": {
      "type": "object"
    },
    "totals": {
      "type": "object"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "enum": [
              "file",
              "directory",
              "symlink"
            ]
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target": {
            "type": "string"
          }
        }
      }
    }
  }
}
