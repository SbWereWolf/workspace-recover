{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-recover/manifest/v2",
  "type": "object",
  "required": [
    "schema",
    "backup",
    "restore",
    "handoff"
  ],
  "properties": {
    "schema": {
      "const": "workspace-recover/manifest/v2"
    },
    "backup": {
      "type": "object",
      "required": [
        "source",
        "provider"
      ]
    },
    "restore": {
      "type": "object",
      "properties": {
        "workflow": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "workflow.schema.json#/$defs/step"
              },
              {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "target": {
          "type": "object"
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "provider"
      ]
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "reporters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "reporter.schema.json"
      }
    },
    "requires": {
      "$ref": "requirements.schema.json"
    }
  },
  "additionalProperties": true
}
