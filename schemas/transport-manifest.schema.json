{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-recover/transport-manifest/v3",
  "type": "object",
  "required": [
    "schema",
    "archive",
    "provider",
    "parts"
  ],
  "properties": {
    "schema": {
      "const": "workspace-recover/transport-manifest/v3"
    },
    "archive": {
      "type": "object",
      "required": [
        "bytes",
        "sha256",
        "format"
      ]
    },
    "provider": {
      "type": "object",
      "required": [
        "type"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
