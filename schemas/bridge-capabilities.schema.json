{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-recover/bridge-capabilities/v3",
  "type": "object",
  "required": [
    "schema",
    "account",
    "operations"
  ],
  "properties": {
    "schema": {
      "const": "workspace-recover/bridge-capabilities/v3"
    },
    "account": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "items": {
        "enum": [
          "drive.upload",
          "drive.download",
          "drive.metadata",
          "gmail.send",
          "gmail.read"
        ]
      }
    },
    "dispatchCommand": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
