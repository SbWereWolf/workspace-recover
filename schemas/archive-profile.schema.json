{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-recover/archive-profile/v3",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "format",
    "pack",
    "unpack"
  ],
  "properties": {
    "schema": {
      "const": "workspace-recover/archive-profile/v3"
    },
    "kind": {
      "const": "exec"
    },
    "format": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"
    },
    "pack": {
      "type": "object",
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "unpack": {
      "type": "object",
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "properties": {
        "executables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "bootstrap": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          },
          "remote": {
            "type": "object",
            "required": [
              "id"
            ]
          }
        }
      }
    }
  }
}
